# Google Cloud & Vertex AI Configuration
GOOGLE_CLOUD_PROJECT=itc-fmcg-agent
GOOGLE_CLOUD_LOCATION=us-east1
GOOGLE_GENAI_USE_VERTEXAI=true

# Google Cloud Storage (Source & Backup)
GCS_BUCKET=itc-fmcg-agent-documents
GCS_SOURCE_PREFIX=itc/source-documents/

# Embedding Configuration
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768

# LLM Generation Model
GENERATION_MODEL=gemini-2.5-flash

# Firestore Knowledge Collection
FIRESTORE_KNOWLEDGE_COLLECTION=itc_knowledge

# Retrieval Configuration
TOP_K=5
RELEVANCE_THRESHOLD=0.35

# Chunking Configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# Local Paths
DATA_SOURCE_DIR=../data/itc-source-documents
VECTOR_STORE_DIR=./data/vector_store
PAGE_IMAGES_DIR=./data/page_images
CHUNKS_DIR=./data/chunks

# Admin Governance & Gmail Notification Alerts (SMTP)
ADMIN_EMAIL=your-admin-email@example.com
APP_URL=https://your-cloud-run-service.run.app
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-admin-email@example.com
SMTP_PASSWORD=your-google-app-password
